PKG_NAME="man-db"
PKG_VERSION="2.12"
PKG_SOURCE="https://download.savannah.gnu.org/releases/man-db/man-db-2.12.1.tar.xz"
PKG_DEPS="glibc groff libpipeline zlib"
PKG_BUILD_DEPS="bison flex gcc make pkg-config"
PKG_DESCRIPTION="Manual page viewer"
PKG_LICENSE="GPL-2.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
    make
    make install
}
