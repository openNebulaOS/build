PKG_NAME="screen"
PKG_VERSION="4.9"
PKG_SOURCE="https://ftp.gnu.org/gnu/screen/screen-4.9.0.tar.gz"
PKG_DEPS="glibc pam"
PKG_BUILD_DEPS="autoconf automake gcc"
PKG_DESCRIPTION="Terminal multiplexer"
PKG_LICENSE="GPL-3.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr --with-socket-dir=/run/screen
    make
    make install
}
