PKG_NAME="groff"
PKG_VERSION="1.23"
PKG_SOURCE="https://ftp.gnu.org/gnu/groff/groff-1.23.0.tar.gz"
PKG_DEPS="glibc libjpeg libpng libtiff perl"
PKG_BUILD_DEPS="gcc make"
PKG_DESCRIPTION="GNU troff typesetter"
PKG_LICENSE="GPL-3.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr
    make
    make install
}
