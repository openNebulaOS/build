PKG_NAME="ncurses"
PKG_VERSION="6.4"
PKG_SOURCE="https://ftp.gnu.org/gnu/ncurses/ncurses-6.4.tar.gz"
PKG_DEPS="glibc"
PKG_BUILD_DEPS="bison flex gcc make"
PKG_DESCRIPTION="Terminal handling library"
PKG_LICENSE="MIT"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --without-shared \
                --with-shared \
                --enable-widec \
                --disable-nls
    make
    make install
}
