PKG_NAME="php"
PKG_VERSION="8.3"
PKG_SOURCE="https://www.php.net/distributions/php-8.3.4.tar.gz"
PKG_DEPS="apache2 curl libxml2 openssl pcre zlib"
PKG_BUILD_DEPS="bison flex gcc make pkg-config"
PKG_DESCRIPTION="PHP scripting language"
PKG_LICENSE="PHP-3.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr --sysconfdir=/etc/php \
        --with-apxs2 --with-config-file-path=/etc/php \
        --enable-mbstring --with-openssl --with-curl
    make
    make install
}
