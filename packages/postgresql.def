PKG_NAME="postgresql"
PKG_VERSION="16"
PKG_SOURCE="https://ftp.postgresql.org/pub/source/v16.2/postgresql-16.2.tar.gz"
PKG_DEPS="libpq libxml2 libxslt openssl zlib"
PKG_BUILD_DEPS="bison flex gcc make"
PKG_DESCRIPTION="PostgreSQL database"
PKG_LICENSE="PostgreSQL"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr --sysconfdir=/etc/postgresql \
        --localstatedir=/var/lib/postgresql
    make
    make install
}
