PKG_NAME="nginx"
PKG_VERSION="1.25"
PKG_SOURCE="https://nginx.org/download/nginx-1.25.4.tar.gz"
PKG_DEPS="glibc openssl pcre zlib"
PKG_BUILD_DEPS="bison flex gcc make pkg-config"
PKG_DESCRIPTION="HTTP and reverse proxy server"
PKG_LICENSE="BSD-2-Clause"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr --conf-path=/etc/nginx/nginx.conf \
        --error-log-path=/var/log/nginx/error.log \
        --http-log-path=/var/log/nginx/access.log \
        --with-http_ssl_module
    make
    make install
}
