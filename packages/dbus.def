PKG_NAME="dbus"
PKG_VERSION="1.15"
PKG_SOURCE="https://dbus.freedesktop.org/releases/dbus/dbus-1.15.0.tar.xz"
PKG_DEPS="expat glibc systemd"
PKG_BUILD_DEPS="gcc make"
PKG_DESCRIPTION="D-Bus message bus system"
PKG_LICENSE="GPL-2.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
                --disable-systemd --enable-shared
    make
    make install
}
