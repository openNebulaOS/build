PKG_NAME="pkg-config"
PKG_VERSION="0.29"
PKG_SOURCE="https://pkgconfig.freedesktop.org/releases/pkg-config-0.29.2.tar.gz"
PKG_DEPS="glibc"
PKG_BUILD_DEPS=""
PKG_DESCRIPTION="Package config utility"
PKG_LICENSE="GPL-2.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr --with-internal-glib
    make
    make install
}
