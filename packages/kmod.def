PKG_NAME="kmod"
PKG_VERSION="31"
PKG_SOURCE="https://www.kernel.org/pub/linux/utils/kernel/kmod/kmod-31.tar.xz"
PKG_DEPS="zlib glibc"
PKG_BUILD_DEPS="gcc make"
PKG_DESCRIPTION="Kernel module management"
PKG_LICENSE="LGPL-2.1"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
    make
    make install
}
