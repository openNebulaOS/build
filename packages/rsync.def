PKG_NAME="rsync"
PKG_VERSION="3.2"
PKG_SOURCE="https://rsync.samba.org/ftp/rsync/src/rsync-3.2.7.tar.gz"
PKG_DEPS="acl popt zlib"
PKG_BUILD_DEPS="gcc make"
PKG_DESCRIPTION="Fast file transfer tool"
PKG_LICENSE="GPL-3.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr
    make
    make install
}
