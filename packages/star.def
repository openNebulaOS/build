PKG_NAME="star"
PKG_VERSION="1.0.0"
PKG_RELEASE="1"
PKG_SOURCE=""
PKG_DEPS="bash curl xz"
PKG_BUILD_DEPS=""
PKG_DESCRIPTION="openNebula Package Manager"
PKG_LICENSE="MIT"
PKG_ARCH="x86_64"

star_install() {
    install -Dm755 /usr/src/star-build/packages/star /usr/bin/star
    install -Dm644 /usr/src/star-build/star/repos.conf /etc/star/repos.conf
    mkdir -p /var/lib/star/db
    mkdir -p /var/cache/star/pkg
    mkdir -p /var/log/star
}
