PKG_NAME="less"
PKG_VERSION="643"
PKG_SOURCE="https://www.greenwoodsoftware.com/less/less-643.tar.gz"
PKG_DEPS="ncurses pcre2"
PKG_BUILD_DEPS="gcc make"
PKG_DESCRIPTION="Pager program"
PKG_LICENSE="GPL-3.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr --with-regex=pcre2
    make
    make install
}
