PKG_NAME="flex"
PKG_VERSION="2.6"
PKG_SOURCE="https://github.com/westes/flex/releases/download/v2.6.4/flex-2.6.4.tar.gz"
PKG_DEPS="glibc m4"
PKG_BUILD_DEPS="bison gcc make"
PKG_DESCRIPTION="Fast lexical analyzer"
PKG_LICENSE="BSD-2-Clause"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr
    make
    make install
}
