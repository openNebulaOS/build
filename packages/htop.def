PKG_NAME="htop"
PKG_VERSION="4.2"
PKG_SOURCE="https://github.com/htop-dev/htop/releases/download/4.2.0/htop-4.2.0.tar.gz"
PKG_DEPS="libnl ncurses"
PKG_BUILD_DEPS="autoconf automake gcc libtool"
PKG_DESCRIPTION="Interactive process viewer"
PKG_LICENSE="GPL-2.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr
    make
    make install
}
