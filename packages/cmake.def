PKG_NAME="cmake"
PKG_VERSION="3.28"
PKG_SOURCE="https://cmake.org/files/v3.28/cmake-3.28.3.tar.gz"
PKG_DEPS="curl expat jsoncpp libarchive libuv rhash zlib"
PKG_BUILD_DEPS="gcc make"
PKG_DESCRIPTION="Cross-platform build system"
PKG_LICENSE="BSD-3-Clause"
PKG_ARCH="x86_64"

build() {
    ./bootstrap --prefix=/usr --datadir=share/cmake
    make
    make install
}
