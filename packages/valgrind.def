PKG_NAME="valgrind"
PKG_VERSION="3.22"
PKG_SOURCE="https://sourceware.org/pub/valgrind/valgrind-3.22.0.tar.bz2"
PKG_DEPS="glibc"
PKG_BUILD_DEPS="gcc make autoconf automake libtool"
PKG_DESCRIPTION="Memory debugging tool"
PKG_LICENSE="GPL-2.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr
    make
    make install
}
