PKG_NAME="wget"
PKG_VERSION="1.21"
PKG_SOURCE="https://ftp.gnu.org/gnu/wget/wget-${PKG_VERSION}.tar.gz"
PKG_DEPS="openssl zlib gnutls"
PKG_DESCRIPTION="Network download utility"

build() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --with-ssl=gnutls
    make
    make install
}
