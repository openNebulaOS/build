PKG_NAME="readline"
PKG_VERSION="8.2"
PKG_SOURCE="https://ftp.gnu.org/gnu/readline/readline-8.2.tar.gz"
PKG_DEPS="glibc ncurses"
PKG_BUILD_DEPS="bison flex gcc make"
PKG_DESCRIPTION="GNU readline library"
PKG_LICENSE="GPL-3.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var
    make
    make install
}
