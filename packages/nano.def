PKG_NAME="nano"
PKG_VERSION="7.2"
PKG_SOURCE="https://www.nano-editor.org/dist/v7/nano-7.2.tar.gz"
PKG_DEPS="glibc ncurses"
PKG_BUILD_DEPS="gcc make pkg-config"
PKG_DESCRIPTION="Text editor"
PKG_LICENSE="GPL-3.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr --enable-nanorc
    make
    make install
}
