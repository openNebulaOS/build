PKG_NAME="ltrace"
PKG_VERSION="0.7"
PKG_SOURCE="https://www.ltrace.org/downloads/ltrace-0.7.91.tar.gz"
PKG_DEPS="glibc libelf"
PKG_BUILD_DEPS="gcc make autoconf automake libtool"
PKG_DESCRIPTION="Library call tracer"
PKG_LICENSE="GPL-2.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr
    make
    make install
}
