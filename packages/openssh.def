PKG_NAME="openssh"
PKG_VERSION="9.6"
PKG_RELEASE="1"
PKG_SOURCE="https://ftp.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-9.6p1.tar.gz"
PKG_DEPS="zlib libedit openssl"
PKG_BUILD_DEPS="bison flex pkg-config"
PKG_DESCRIPTION="Secure shell daemon and client"
PKG_LICENSE="BSD-2-Clause"
PKG_ARCH="x86_64"

build_openssh() {
    ./configure --prefix=/usr --sysconfdir=/etc/ssh --localstatedir=/var \
        --with-pam --with-libedit --with-zlib
    make -j$(nproc)
    make install
}
