PKG_NAME="acl"
PKG_VERSION="2.3"
PKG_SOURCE="https://download.savannah.gnu.org/releases/acl/acl-2.3.1.tar.gz"
PKG_DEPS="attr glibc"
PKG_BUILD_DEPS="gcc make"
PKG_DESCRIPTION="Access control list utilities"
PKG_LICENSE="LGPL-2.1"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
    make
    make install
}
