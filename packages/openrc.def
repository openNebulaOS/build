PKG_NAME="openrc"
PKG_VERSION="0.53"
PKG_RELEASE="1"
PKG_SOURCE="https://github.com/OpenRC/openrc/archive/refs/tags/v0.53.tar.gz"
PKG_DEPS="bash"
PKG_BUILD_DEPS="meson ninja pkg-config"
PKG_DESCRIPTION="OpenRC init system"
PKG_LICENSE="BSD-2-Clause"
PKG_ARCH="x86_64"

build_openrc() {
    meson setup build --prefix=/usr --sysconfdir=/etc --localstatedir=/var
    ninja -C build
    ninja -C build install
}
