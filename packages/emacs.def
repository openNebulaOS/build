PKG_NAME="emacs"
PKG_VERSION="29.3"
PKG_SOURCE="https://ftp.gnu.org/gnu/emacs/emacs-29.3.tar.gz"
PKG_DEPS="gnutls libjpeg libpng libtiff libxml2 ncurses zlib"
PKG_BUILD_DEPS="gcc make"
PKG_DESCRIPTION="GNU Emacs editor"
PKG_LICENSE="GPL-3.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr --with-native-compilation
    make
    make install
}
