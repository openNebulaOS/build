PKG_NAME="python"
PKG_VERSION="3.12"
PKG_SOURCE="https://www.python.org/ftp/python/3.12.2/Python-3.12.2.tar.xz"
PKG_DEPS="bz2 expat gdbm libnsl libnsl2 libffi openssl readline sqlite tcl zlib"
PKG_BUILD_DEPS="bison gcc make"
PKG_DESCRIPTION="Python programming language"
PKG_LICENSE="Python-2.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr --enable-shared --without-ensurepip
    make
    make install
}
