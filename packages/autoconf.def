PKG_NAME="autoconf"
PKG_VERSION="2.72"
PKG_SOURCE="https://ftp.gnu.org/gnu/autoconf/autoconf-2.72.tar.gz"
PKG_DEPS="m4 perl"
PKG_BUILD_DEPS=""
PKG_DESCRIPTION="Automatic configure script builder"
PKG_LICENSE="GPL-3.0"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr
    make
    make install
}
