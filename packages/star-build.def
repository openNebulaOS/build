PKG_NAME="star-build"
PKG_VERSION="1.0.0"
PKG_RELEASE="1"
PKG_SOURCE=""
PKG_DEPS="bash git curl xz tar"
PKG_BUILD_DEPS=""
PKG_DESCRIPTION="openNebula Package Build System"
PKG_LICENSE="MIT"
PKG_ARCH="x86_64"

star_install() {
    install -Dm755 /usr/src/star-build/star-build /usr/bin/star-build
    mkdir -p /var/cache/star-build/{sources,packages,tmp}
}
