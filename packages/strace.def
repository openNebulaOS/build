PKG_NAME="strace"
PKG_VERSION="6.7"
PKG_SOURCE="https://github.com/strace/strace/releases/download/v6.7/strace-6.7.tar.xz"
PKG_DEPS="glibc"
PKG_BUILD_DEPS="autoconf automake libtool"
PKG_DESCRIPTION="System call tracer"
PKG_LICENSE="LGPL-2.1"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr
    make
    make install
}
