PKG_NAME="libcap"
PKG_VERSION="2.68"
PKG_SOURCE="https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-2.68.tar.xz"
PKG_DEPS="attr glibc"
PKG_BUILD_DEPS="gcc make"
PKG_DESCRIPTION="POSIX capabilities library"
PKG_LICENSE="BSD-2-Clause"
PKG_ARCH="x86_64"

build() {
    make prefix=/usr lib=lib build= no_shlib=0
    make prefix=/usr lib=lib install
}
