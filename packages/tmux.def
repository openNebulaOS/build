PKG_NAME="tmux"
PKG_VERSION="3.4"
PKG_SOURCE="https://github.com/tmux/tmux/releases/download/3.4/tmux-3.4.tar.gz"
PKG_DEPS="libevent ncurses"
PKG_BUILD_DEPS="bison gcc make pkg-config"
PKG_DESCRIPTION="Terminal multiplexer"
PKG_LICENSE="ISC"
PKG_ARCH="x86_64"

build() {
    ./configure --prefix=/usr
    make
    make install
}
