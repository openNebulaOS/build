#!/bin/bash

boot_splash() {
    clear
    cat << 'EOF'
                              _______        ___.         .__          
  ____ ______   ____   ____   \      \   ____\_ |__  __ __|  | _____   
 /  _ \\____ \_/ __ \ /    \  /   |   \_/ __ \| __ \|  |  \  | \__  \  
(  <_> )  |_> >  ___/|   |  \/    |    \  ___/| \_\ \  |  /  |__/ __ \_
 \____/|   __/ \___  >___|  /\____|__  /\___  >___  /____/|____(____  /
       |__|        \/     \/         \/     \/    \/                \/ 

EOF
}

boot_splash

echo "Starting kernel..."
sleep 1
