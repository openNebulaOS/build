#!/bin/bash

TARGET="x86_64-opennebula-linux-gnu"
PREFIX="/usr"
SYSROOT="/usr/src/openNebula-rootfs"
MAKEFLAGS="-j$(nproc 2>/dev/null || echo 4)"

export CC="${TARGET}-gcc"
export CXX="${TARGET}-g++"
export AR="${TARGET}-ar"
export RANLIB="${TARGET}-ranlib"
export STRIP="${TARGET}-strip"
export NM="${TARGET}-nm"
export OBJDUMP="${TARGET}-objdump"
export READELF="${TARGET}-readelf"
export OBJCOPY="${TARGET}-objcopy"

export SYSROOT
export PREFIX
export MAKEFLAGS

echo "Cross-compilation environment for $TARGET"
echo "Sysroot: $SYSROOT"
echo "Prefix: $PREFIX"
